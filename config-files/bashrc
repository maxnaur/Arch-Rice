# this function allows the user to enter the USB port number for cisco devices
putty() {
  ls /dev | grep ttyUSB
  read -r -n 1 -p "" k
  if [ "$k" != "q" ]; then
    sudo screen /dev/ttyUSB"$k" 9600
  else
    echo ""
  fi
}

