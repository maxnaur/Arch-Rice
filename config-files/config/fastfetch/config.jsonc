{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {                // the big image
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/ascii/\" -name \"*.txt\" | sort -R | head -1)",
    "width": null,         // Width in characters 40
    "height": null,        // Height in characters 19
    "padding": {           // 1 char space on side
        "top": 0,
        "left": 2,
        "right": 1,
        //"bottom": 1,     // does nothing if you want padding set hight 
    },
    "color": {             // Override logo colors
        "1": "blue",
        "2": "green"
    }
  },
  "display": {             // how the text will be displayed
    "separator": ": ",     // Separator between keys and values
    "color": {
        "title": "#c25aff",// Name of computer/user title
        "keys": "blue",    // identifyer color
        "output": ""       // the text on far left leved default
    },
    "key": { 
        "width": 13,       // space for identifyer
        "type": "string"   // string, icon, both, or none
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
  },
  "modules": [
    {
      "type": "title",
      "keyIcon": ""
    },
    "separator",
    {
        "type": "os",
        "key": " OS",
        //"format": "{name}"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "temp": false,
      "showPeCoreCount": false,
      "tempSensor": ""
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none"
    },
    {
      "type": "memory",
      "key": " RAM"
    },
    {
      "type": "swap",
      "key": "󰓡 RAM"
    }
  ]
}
