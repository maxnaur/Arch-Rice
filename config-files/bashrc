# image display
icat() { kitten icat "$@"; }

# image folder display with dellay between images
icatfolder() {
  local dir="${1:-$PWD}"
  local -a files=()

  # input
  mapfile -t files < <(
    find "$dir" -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o \
      -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
      \) | sort
  )
  if ((${#files[@]} == 0)); then
    echo "No images found in: $dir" >&2
    return 1
  fi

  # display
  echo "Press space for next (q to quit):"
  local f k
  for f in "${files[@]}"; do
    echo "$f"
    kitten icat "$f"

    read -r -n 1 -p "" k
    [[ "$k" == "q" ]] && break
  done
}

