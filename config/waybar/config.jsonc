// -*- mode: jsonc -*-
{
  "layer": "bottom", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  // "height": 30, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 2, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": [
      "hyprland/workspaces",
  ],
      //"backlight",
  "modules-center": [
      "clock",
  ],
  "modules-right": [
      "pulseaudio#output",
      "pulseaudio#input",
      "bluetooth",
      "backlight",
      "network",
      "cpu",
      "memory",
      "temperature",
      "battery",
      "tray"
  ],
    //"wireplumber",
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "show-special": true,
    "sort-by-number": true
  },
  "clock": {
    "timezone": "Europe/London",
    "format": "{:%I:%M}",
    "format-alt": "{:%d-%m}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "backlight": {
    // "device": "acpi_video1",
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl -qd intel_backlight set +4%",
    "on-scroll-down": "brightnessctl -qd intel_backlight set 4%- --min 0",
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false,
  },
  "memory": {
    "format": "{}% ",
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 90,
    "format": "{temperatureC}°C {icon}",
    "format-alt": "{icon}",
    "format-icons": ["", "", "", "", ""]
  },
  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "format": "{capacity}% {icon}",
    "format-alt": "{time} {icon}",
    "format-full": "",
    "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
  },
  "network": {
    "format-wifi": "{signalStrength}% {icon}", //"{essid} ({signalStrength}%) ",
    "format-ethernet": "󰈀",
    "tooltip-format": "{ifname} via {gwaddr}/{cidr}  ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    // interface
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click-right": "~/.local/bin/hyprltm-net",
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "{num_connections} ",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueberry",
    "on-click-right": "blueberry",
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "󰍭",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%",
    "on-click-right": "pavucontrol",
  },
  "pulseaudio#output": {
    // "scroll-step": 1, // %, can be a float
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-bluetooth-muted": "{icon} ",
    "format-muted": "󰍭",
    "format-icons": {
        "headphone": "",
        "hands-free": "󰋎",
        "headset": "󰋎",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
  },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "󰖁",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-"
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
  },
}
