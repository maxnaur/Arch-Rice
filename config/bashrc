# image display
icat() {
  kitten icat "$@"
}

# image folder display with dellay between images
icatfolder() {
  local dir="${1:-$PWD}"
  local -a files=()

  # input
  mapfile -t files < <(
    find "$dir" -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o \
      -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
      \) | sort
  )
  # ensure input
  if ((${#files[@]} == 0)); then
    echo "No images found in: $dir" >&2
    return 1
  fi

  # display
  echo "Press space for next (q to quit):"
  local f k
  for f in "${files[@]}"; do
    echo "$f"
    kitten icat "$f"

    read -r -n 1 -p "" k
    [[ "$k" == "q" ]] && break
  done
}

# update everything
update() {
  cashe
  yay
  flatpak update
  Linuwu-Sense
}

Linuwu-Sense() {
  # fix nvidia drivers
  sudo pacman -Sy linux-headers

  cd ~/AUR/ || return

  if [ -d "Linuwu-Sense" ]; then
    cd Linuwu-Sense
    git fetch
    # Compare local HEAD with the remote tracking branch
    LOCAL=$(git rev-parse @)
    REMOTE=$(git rev-parse @{u})

    if [ "$LOCAL" != "$REMOTE" ]; then
      git pull
    fi
    cd ..
  else
    git clone https://github.com/0x7375646F/Linuwu-Sense.git
  fi

  cd Linuwu-Sense
  make install
  cd || return
}

cashe() {
  # This looks at the available space on the root partition
  local before=$(df / --output=avail | tail -n 1)

  echo "Cleaning system cache..."
  yes | sudo pacman -Sc              # pacman package versions
  sudo rm -f /var/cache/pacman/pkg/* # remove anything that couldn't be removed
  flatpak uninstall --unused         # flatpak cash
  sudo journalctl --vacuum-size=500M # log files
  rm -rf ~/.cache/*                  # the cache

  # Capture disk usage after cleanup
  local after=$(df / --output=avail | tail -n 1)
  local saved=$((after - before))  # Calculate the difference
  local saved_mb=$((saved / 1024)) # Convert Kilobytes to Megabytes for readability

  echo "Space recovered: ${saved_mb} MB"
}

# Sync Arch-Rice to github
rice() {
  rice-update
  cd ~/Documents/Arch-Rice/ || return
  git rm -r --cached .gitignore
  git add .
  git commit -m "$1"
  git push origin main
  cd || return
}

# Rice update config files
rice-update() {
  # Update bashrc
  cp ~/.bashrc ~/Documents/Arch-Rice/config/bashrc

  # update config folders
  folders=("BraveSoftware" "discord" "fastfetch" "hypr" "kitty" "net.imput.helium" "vesktop" "waybar" "zen")

  for folder in "${folders[@]}"; do
    local src="~/.config/$folder"
    local dest="~/Documents/Arch-Rice/config/$folder"

    # Expand tildes for the find and sha256sum commands
    local src_expanded=$(eval echo "$src")
    local dest_expanded=$(eval echo "$dest")

    # Calculate hash of current config and backup config
    # We find all files, sort them by name to ensure consistency, and hash their contents
    local src_hash=$(find "$src_expanded" -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')
    local dest_hash=$(find "$dest_expanded" -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')

    if [ "$src_hash" != "$dest_hash" ]; then
      echo $folder
      rm -rf "$dest_expanded"
      cp -r "$src_expanded" "$dest_expanded"
    fi
  done
}

